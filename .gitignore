# Chrome 浏览器自动化 profile 数据（运行时生成，含本地缓存/会话数据，不入库）
chrome_profiles/
chrome_profile/

# 超长提示词落盘文件（prompt_*.txt 含用户提示词原文，不入库）
uploads/

# 日志：log/app 运行日志、log/error 错误与崩溃现场、
# log/supervisor 进程管理器捕获的 stdout/stderr、log/archive 历史归档
log/

# 迁到 log/ 之前散落在根目录的日志，防止再被提交
/*.log
/*.log.corrupt

# 上游基线快照（本地留存，不入库）
universalweb-api-main

# 账号受限冷却登记（运行时生成，到期自清，机器相关）
site_state.json

# 其余运行时状态：积分/过长标记记录与会话绑定，机器相关，入库只会造成
# 每次跑测试都产生假 diff（测试已改为写临时目录）
credit_state.json
session_bindings.json

# Python 字节码与测试缓存
__pycache__/
*.pyc
.pytest_cache/
