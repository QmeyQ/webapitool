  "poe.com": {
    "entry_url": "https://poe.com/Assistant",
    "MODEL_URL_TEMPLATE": "https://poe.com/{model}",
    "selectors": {
      "input_box": "textarea[class*=\"GrowingTextArea\"]",
      "send_btn": "button[data-button-send=\"true\"]",
      "result_container": "[class*=\"Message_row\"]:not([class*=\"rightSide\"])",
      "new_chat_btn": "a[href=\"/\"]",
      "message_wrapper": "[class*=\"Message_row\"]",
      "generating_indicator": "button[aria-label=\"停止\"], button[aria-label=\"Stop\"]",
      "upload_btn": "button[aria-label=\"选择附件\"]",
      "file_input": "input[type='file']"
    },
    "workflow": [
      {
        "action": "NAVIGATE",
        "target": "input_box",
        "optional": false,
        "value": "https://poe.com/Assistant"
      },
      {
        "action": "WAIT",
        "target": "",
        "optional": false,
        "value": "1.0"
      },
      {
        "action": "FILL_INPUT",
        "target": "input_box",
        "optional": false,
        "value": null
      },
      {
        "action": "CLICK",
        "target": "send_btn",
        "optional": true,
        "value": null
      },
      {
        "action": "KEY_PRESS",
        "target": "Enter",
        "optional": true,
        "value": null
      },
      {
        "action": "STREAM_WAIT",
        "target": "result_container",
        "optional": false,
        "value": null
      }
    ],
    "stealth": true,
    "upload_config": {
      "enabled": false
    },
    "CHUNK_CHARS": 3500
  },
